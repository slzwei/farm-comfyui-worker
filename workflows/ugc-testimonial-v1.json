{
  "_meta": {
    "workflowId": "ugc-testimonial-v1",
    "version": "3",
    "status": "ACTIVE",
    "description": "UGC/creator shot on MiniMax H3 Ref2VA. Takes TWO references: the locked creator identity (ref_image_0) and the product (ref_image_1), so every video features the SAME recognisable presenter holding the real packaging. Identity consistency is what turns a pile of clips into a channel \u2014 viewers must recognise her.",
    "model": {
      "family": "minimax-h3",
      "variant": "ref2va-pruned-int8",
      "diffusionModel": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "textEncoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "videoVae": "minimax_h3_video_vae_fp16.safetensors",
      "audioVae": "minimax_h3_audio_vae_fp32.safetensors",
      "turboLora": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "requiresComfyUi": ">=0.30.0",
      "vramNote": "same ~37GB resident footprint as FL2VA; target the 96GB RTX PRO 6000."
    },
    "constraints": {
      "dimensionMultiple": 32,
      "frameQuantum": 17,
      "frameQuantumOffset": 5,
      "maxFrames": 3600,
      "minFrames": 5,
      "nativeFps": 24,
      "note": "Same 17k+5 latent grid as FL2VA. 241 frames ~= 10s at 24fps."
    },
    "generation": {
      "steps": 4,
      "sampler": "res_multistep",
      "scheduler": "simple",
      "turboLoraStrength": 1.0,
      "note": "Defaults are the fast turbo path (4 steps, LoRA 1.0). For realistic, less plastic output pass parameters.steps=20 and parameters.lora_strength=0 \u2014 roughly 5x the GPU time but materially better skin and motion. The turbo LoRA is the main cause of the 'AI look'."
    },
    "injection": {
      "creator_image": {
        "node": "18",
        "input": "image",
        "note": "locked creator identity -> ref_image_0"
      },
      "product_image": {
        "node": "7",
        "input": "image",
        "note": "real packaging -> ref_image_1"
      },
      "prompt": {
        "node": "8",
        "input": "prompt"
      },
      "seed": {
        "node": "9",
        "input": "noise_seed"
      },
      "width": {
        "node": "8",
        "input": "width"
      },
      "height": {
        "node": "8",
        "input": "height"
      },
      "frame_count": {
        "node": "8",
        "input": "length"
      },
      "fps": {
        "node": "16",
        "input": "fps"
      },
      "output": {
        "node": "17"
      },
      "steps": {
        "node": "12",
        "input": "steps",
        "note": "sampling steps; 4 with turbo LoRA, 20+ for realism"
      },
      "lora_strength": {
        "node": "5",
        "input": "strength_model",
        "note": "turbo LoRA strength; 0 disables it for full quality"
      }
    },
    "creator": {
      "id": "mei",
      "identityAsset": "assets/creators/mei-identity.png",
      "note": "Locked 27 Aug 2026. Chosen from 3 candidates because the product text rendered correctly (the other two mirrored it) and the expression read as genuine. Do not regenerate the face \u2014 reuse this reference."
    }
  },
