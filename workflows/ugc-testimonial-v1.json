{
  "_meta": {
    "workflowId": "ugc-testimonial-v1",
    "version": "1",
    "status": "ACTIVE",
    "description": "UGC-style talking/holding shot on MiniMax H3 Ref2VA (reference-to-video). Unlike product-demo-v1 (FL2VA), which can only animate an existing still, this generates a PERSON around the product while keeping the real packaging identity from reference images. This is the format that actually converts on TikTok Shop — faces and hands beat catalogue b-roll. Node ids are internal to this file plus the worker.",
    "model": {
      "family": "minimax-h3",
      "variant": "ref2va-pruned-int8",
      "diffusionModel": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "textEncoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "videoVae": "minimax_h3_video_vae_fp16.safetensors",
      "audioVae": "minimax_h3_audio_vae_fp32.safetensors",
      "turboLora": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
      "requiresComfyUi": ">=0.30.0",
      "vramNote": "same ~37GB resident footprint as FL2VA; target the 96GB RTX PRO 6000."
    },
    "constraints": {
      "dimensionMultiple": 32,
      "frameQuantum": 17,
      "frameQuantumOffset": 5,
      "maxFrames": 3600,
      "minFrames": 5,
      "nativeFps": 24,
      "note": "Same 17k+5 latent grid as FL2VA. 241 frames ~= 10s at 24fps."
    },
    "generation": {
      "steps": 4,
      "sampler": "res_multistep",
      "scheduler": "simple",
      "turboLoraStrength": 1.0,
      "note": "4 steps with the ref2v 4-step turbo LoRA (the official r2v template's turbo path). Full quality: node 5 strength 0 and node 12 steps 20."
    },
    "injection": {
      "product_image": { "node": "7", "input": "image", "note": "reference image locking the real packaging identity; worker downloads source_assets[role=product_image] here" },
      "prompt": { "node": "8", "input": "prompt" },
      "seed": { "node": "9", "input": "noise_seed" },
      "width": { "node": "8", "input": "width" },
      "height": { "node": "8", "input": "height" },
      "frame_count": { "node": "8", "input": "length" },
      "fps": { "node": "16", "input": "fps" },
      "output": { "node": "17" }
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
    },
    "5": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["1", 0],
        "lora_name": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
        "strength_model": 1.0
      }
    },
    "7": {
      "class_type": "LoadImage",
      "inputs": { "image": "product.png" }
    },
    "8": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": ["2", 0],
        "vae": ["3", 0],
        "audio_vae": ["4", 0],
        "ref_images.ref_image_0": ["7", 0],
        "prompt": "A person presenting the product to camera.",
        "width": 704,
        "height": 1280,
        "length": 241,
        "ref_image_size": "match"
      }
    },
    "9": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
    "10": {
      "class_type": "BasicGuider",
      "inputs": { "model": ["5", 0], "conditioning": ["8", 0] }
    },
    "11": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
    "12": {
      "class_type": "BasicScheduler",
      "inputs": { "model": ["5", 0], "scheduler": "simple", "steps": 4, "denoise": 1.0 }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["9", 0],
        "guider": ["10", 0],
        "sampler": ["11", 0],
        "sigmas": ["12", 0],
        "latent_image": ["8", 1]
      }
    },
    "14": { "class_type": "VAEDecode", "inputs": { "samples": ["13", 0], "vae": ["3", 0] } },
    "15": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["13", 0], "vae": ["4", 0] } },
    "16": {
      "class_type": "CreateVideo",
      "inputs": { "images": ["14", 0], "audio": ["15", 0], "fps": 24 }
    },
    "17": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["16", 0],
        "filename_prefix": "farm/clip",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
