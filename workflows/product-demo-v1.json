{
  "_meta": {
    "workflowId": "product-demo-v1",
    "version": "2",
    "status": "ACTIVE",
    "description": "Image-to-video product demo on MiniMax H3 (open weights, ComfyUI API format). The product reference image is the first frame; the brief-derived prompt drives motion, and H3 generates native stereo audio in the same pass. v2 replaces the Wan 2.2 TI2V-5B graph of v1: H3 removes the ~5s ceiling (up to 3600 frames) and adds audio, which Wan could not do. Node ids are an implementation detail of this file plus the worker; nothing farm-side may reference them.",
    "model": {
      "family": "minimax-h3",
      "variant": "fl2va-pruned-int8",
      "diffusionModel": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "textEncoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "videoVae": "minimax_h3_video_vae_fp16.safetensors",
      "audioVae": "minimax_h3_audio_vae_fp32.safetensors",
      "turboLora": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "source": "Comfy-Org/MiniMax-H3 + lightx2v/Minimax-h3-Turbo (HuggingFace)",
      "license": "MiniMax H3 Community License — commercial use permitted under $20M revenue, attribution required",
      "requiresComfyUi": ">=0.30.0",
      "vramNote": "diffusion ~21GB + text encoder ~15.7GB resident; target 48GB+ GPUs (L40S / A6000 / RTX 6000 Ada). 24GB cards offload heavily and are much slower."
    },
    "constraints": {
      "dimensionMultiple": 32,
      "frameQuantum": 17,
      "frameQuantumOffset": 5,
      "maxFrames": 3600,
      "minFrames": 5,
      "nativeFps": 24,
      "note": "H3 latent lengths are 17k+5 frames. 124 frames ~= 5.2s, 430 ~= 17.9s at 24fps. The worker snaps requested durations onto this grid, so full-length briefs (18s) now render in one pass — no stitching."
    },
    "generation": {
      "steps": 6,
      "sampler": "res_multistep",
      "scheduler": "simple",
      "turboLoraStrength": 1.0,
      "note": "6 steps with the lightx2v 8-step turbo LoRA at strength 1.0 (the official template's turbo path). Full-quality alternative: set node 5 strength_model to 0 and node 12 steps to 20, at roughly 3x the GPU time."
    },
    "injection": {
      "product_image": { "node": "7", "input": "image", "note": "worker downloads source_assets[role=product_image] into ComfyUI's input dir and sets this filename" },
      "prompt": { "node": "8", "input": "prompt", "note": "H3 takes the prompt directly on the I2V node — there is no separate CLIPTextEncode and no negative-prompt input" },
      "seed": { "node": "9", "input": "noise_seed" },
      "width": { "node": "8", "input": "width" },
      "height": { "node": "8", "input": "height" },
      "frame_count": { "node": "8", "input": "length", "note": "frames snapped to 17k+5" },
      "fps": { "node": "16", "input": "fps" },
      "output": { "node": "17", "note": "SaveVideo — the worker collects the mp4 this node writes from ComfyUI history" }
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    "5": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["1", 0],
        "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
        "strength_model": 1.0
      }
    },
    "7": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "product.png"
      }
    },
    "8": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": ["2", 0],
        "vae": ["3", 0],
        "first_frame": ["7", 0],
        "prompt": "Product demonstration video: the product is shown in use, clean studio lighting, smooth camera motion, high detail.",
        "width": 704,
        "height": 1280,
        "length": 124
      }
    },
    "9": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 0
      }
    },
    "10": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": ["5", 0],
        "conditioning": ["8", 0]
      }
    },
    "11": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "12": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": ["5", 0],
        "scheduler": "simple",
        "steps": 6,
        "denoise": 1.0
      }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["9", 0],
        "guider": ["10", 0],
        "sampler": ["11", 0],
        "sigmas": ["12", 0],
        "latent_image": ["8", 1]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["13", 0],
        "vae": ["3", 0]
      }
    },
    "15": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": ["13", 0],
        "vae": ["4", 0]
      }
    },
    "16": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["14", 0],
        "audio": ["15", 0],
        "fps": 24
      }
    },
    "17": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["16", 0],
        "filename_prefix": "farm/clip",
        "format": "auto",
        "codec": "auto"
      }
    }
  }
}
