{
  "_meta": {
    "workflowId": "product-demo-v1",
    "version": "1",
    "status": "ACTIVE",
    "description": "Image-to-video product demo on Wan 2.2 TI2V-5B (ComfyUI API format). The product reference image drives an ~5s portrait clip guided by the brief-derived prompt. The RunPod worker bundles this file, injects the semantic inputs below, and never accepts graphs from callers. Node ids are an implementation detail of this file + the worker — nothing farm-side may reference them.",
    "model": {
      "family": "wan2.2",
      "variant": "ti2v-5B",
      "diffusionModel": "wan2.2_ti2v_5B_fp16.safetensors",
      "textEncoder": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "vae": "wan2.2_vae.safetensors",
      "source": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged (HuggingFace split_files)"
    },
    "constraints": {
      "dimensionMultiple": 32,
      "frameQuantum": 4,
      "frameQuantumOffset": 1,
      "maxFrames": 121,
      "minFrames": 9,
      "nativeFps": 24,
      "note": "Wan VAE compresses 4x temporally (valid lengths are 4k+1) and 32x spatially after patchify. Requests are snapped/clamped by the worker; ~5s @ 24fps is the v1 ceiling — longer briefs are clamped and QC flags DURATION_MISMATCH for human review."
    },
    "injection": {
      "product_image": { "node": "6", "input": "image", "note": "worker downloads source_assets[role=product_image] into ComfyUI's input dir and sets the filename here" },
      "prompt": { "node": "4", "input": "text" },
      "negative_prompt": { "node": "5", "input": "text" },
      "seed": { "node": "9", "input": "seed" },
      "width": { "node": "8", "input": "width" },
      "height": { "node": "8", "input": "height" },
      "frame_count": { "node": "8", "input": "length", "note": "frames = snap(duration_seconds * fps) to 4k+1, clamped to [minFrames, maxFrames]" },
      "fps": { "node": "11", "input": "fps" },
      "output": { "node": "12", "note": "SaveVideo — the worker collects the mp4 this node writes from ComfyUI history" }
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "Product demonstration video: the product is shown in use, clean studio lighting, smooth camera motion, high detail."
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"
      }
    },
    "6": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "product.png"
      }
    },
    "7": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": ["1", 0],
        "shift": 8.0
      }
    },
    "8": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": ["3", 0],
        "width": 704,
        "height": 1280,
        "length": 121,
        "batch_size": 1,
        "start_image": ["6", 0]
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["7", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["8", 0],
        "seed": 0,
        "steps": 30,
        "cfg": 5.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["9", 0],
        "vae": ["3", 0]
      }
    },
    "11": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["10", 0],
        "fps": 24
      }
    },
    "12": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["11", 0],
        "filename_prefix": "farm/clip",
        "format": "mp4",
        "codec": "h264"
      }
    }
  }
}
